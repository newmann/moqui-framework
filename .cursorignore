!/runtime
!/runtime/**

# Generated and local data
/runtime/log/
/runtime/db/
/runtime/sessions/
/runtime/txlog/
/runtime/tmp/
/docker/db/
/docker/minio/data/
/docker/opensearch/data/
/docker/elasticsearch/
